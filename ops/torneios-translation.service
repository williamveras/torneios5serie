[Unit]
Description=Translate public tournament text locally
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/opt/torneios-translation/venv/bin/python /opt/torneios-translation/translation_worker.py
TimeoutStartSec=400
Nice=19
CPUQuota=75%
MemoryMax=1800M
Environment=ARGOS_DEVICE_TYPE=cpu
Environment=OMP_NUM_THREADS=1
Environment=ARGOS_INTER_THREADS=1
Environment=ARGOS_INTRA_THREADS=1
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
